PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
TAVILY_API_KEY=
GEMINI_API_KEY=

# Admin approval + send
#
# Set RESEND_API_KEY to send via Resend's HTTPS API (required on Render's free
# tier, which blocks outbound SMTP ports -- see app/email_sender.py). Leave it
# unset to fall back to Gmail SMTP (fine for local dev or hosts that don't
# block SMTP). Get a free key at https://resend.com (3,000 emails/month, no
# card, no domain verification needed to send to your own account's email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=

# 'everyone' (default): any logged-in user can access /admin.
# 'admin_only': restricted to the emails listed in ADMIN_EMAILS below.
ADMIN_DASHBOARD_ACCESS=everyone
ADMIN_EMAILS=
